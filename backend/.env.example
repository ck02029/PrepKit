# Backend settings. Copy this file to backend/.env and fill in local secrets.
PORT=8000
DATABASE_URL=postgres://prepkit:replace-with-a-long-url-safe-password@localhost:5432/prepkit
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Set one or both provider keys. Gemini is also used for grounded web search.
GEMINI_API_KEY=
GEMINI_API_KEYS=
LLM_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_API_KEYS=
OPENAI_MODEL=gpt-4.1-mini

# Provider pacing, database pool, and bounded input/research defaults.
LLM_MIN_REQUEST_INTERVAL_MS=5000
LLM_DAILY_CALLS_PER_KEY=150
LLM_MAX_OUTPUT_TOKENS=8192
MAX_QUESTIONS_PER_CATEGORY=6
MAX_KITS_PER_DAY=10
REGENERATIONS_PER_HOUR=6
DB_POOL_MAX=10
MAX_DAYS=60
MAX_JD_CHARS=30000
FETCH_TIMEOUT_MS=8000
FETCH_MAX_BYTES=1500000
CRAWL_MAX_PAGES=12
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
