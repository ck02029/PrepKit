{
  "name": "prepkit-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start:api": "node dist/backend/src/server.js",
    "start:worker": "node dist/backend/src/worker.js",
    "start:api-with-worker": "node dist/backend/src/server-with-worker.js",
    "build": "tsc -p tsconfig.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "tsc -p tsconfig.test.json && node --import ./.test-dist/backend/src/test-setup.js --test ./.test-dist/backend/src/*.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node --import ./.test-dist/backend/src/test-setup.js --test ./.test-dist/backend/src/integration/*.test.js",
    "evaluate": "tsx src/evaluate.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "fast-check": "^4.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
